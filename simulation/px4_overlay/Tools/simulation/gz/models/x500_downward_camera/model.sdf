<?xml version="1.0" encoding="UTF-8"?>
<sdf version="1.9">
  <model name="x500_downward_camera">
    <self_collide>false</self_collide>
    <!-- Keep the stock x500 flight dynamics and PX4 sensors. -->
    <include merge="true">
      <uri>model://x500</uri>
    </include>
    <link name="front_camera_link">
      <inertial>
        <mass>0.001</mass>
        <inertia>
          <ixx>1e-7</ixx><iyy>1e-7</iyy><izz>1e-7</izz>
        </inertia>
      </inertial>
      <visual name="housing">
        <geometry><box><size>0.04 0.04 0.025</size></box></geometry>
        <material>
          <ambient>0.05 0.05 0.05 1</ambient>
          <diffuse>0.1 0.1 0.1 1</diffuse>
          <specular>0 0 0 1</specular>
        </material>
      </visual>
      <sensor name="front_camera" type="camera">
        <!-- Gazebo cameras look along local +X, which is vehicle-forward
             because this sensor is aligned with base_link. -->
        <pose relative_to="front_camera_link">0 0 0 0 0 0</pose>
        <gz_frame_id>front_camera_link</gz_frame_id>
        <topic>/camera/front/image</topic>
        <camera>
          <horizontal_fov>1.0471975512</horizontal_fov>
          <image>
            <width>320</width><height>240</height><format>R8G8B8</format>
          </image>
          <clip><near>0.05</near><far>40.0</far></clip>
        </camera>
        <always_on>true</always_on>
        <update_rate>20</update_rate>
        <visualize>true</visualize>
      </sensor>
    </link>
    <joint name="front_camera_joint" type="fixed">
      <parent>base_link</parent>
      <child>front_camera_link</child>
      <pose relative_to="base_link">0.20 0 0.05 0 0 0</pose>
    </joint>
    <link name="downward_camera_link">
      <inertial>
        <mass>0.001</mass>
        <inertia>
          <ixx>1e-7</ixx><iyy>1e-7</iyy><izz>1e-7</izz>
        </inertia>
      </inertial>
      <visual name="housing">
        <geometry><box><size>0.04 0.04 0.025</size></box></geometry>
        <material>
          <ambient>0.05 0.05 0.05 1</ambient>
          <diffuse>0.1 0.1 0.1 1</diffuse>
          <specular>0 0 0 1</specular>
        </material>
      </visual>
      <sensor name="downward_camera" type="camera">
        <!-- Gazebo camera looks along local +X. Ry(+pi/2) maps it to
             vehicle -Z, giving a true vertical downward optical axis. -->
        <pose relative_to="downward_camera_link">0 0 0 0 1.57079632679 0</pose>
        <gz_frame_id>downward_camera_link</gz_frame_id>
        <topic>/camera/down/image</topic>
        <camera>
          <horizontal_fov>1.0471975512</horizontal_fov>
          <image>
            <width>320</width><height>240</height><format>R8G8B8</format>
          </image>
          <clip><near>0.05</near><far>30.0</far></clip>
        </camera>
        <always_on>true</always_on>
        <update_rate>20</update_rate>
        <visualize>true</visualize>
      </sensor>
    </link>
    <joint name="downward_camera_joint" type="fixed">
      <parent>base_link</parent>
      <child>downward_camera_link</child>
      <pose relative_to="base_link">0 0 -0.10 0 0 0</pose>
    </joint>
  </model>
</sdf>
