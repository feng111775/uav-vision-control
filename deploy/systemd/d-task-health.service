[Unit]
Description=D-task read-only health service

[Service]
Type=simple
EnvironmentFile=/etc/d-task/d-task.env
WorkingDirectory=${D_TASK_WS}
ExecStart=/bin/bash -lc 'source /opt/ros/jazzy/setup.bash; source ${D_TASK_WS}/install/setup.bash; ros2 run uav_control system_health_node'
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
