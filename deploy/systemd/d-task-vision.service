[Unit]
Description=D-task formal vision chain
After=d-task-agent.service

[Service]
Type=simple
EnvironmentFile=/etc/d-task/d-task.env
WorkingDirectory=${D_TASK_WS}
ExecStart=/bin/bash -lc 'source /opt/ros/jazzy/setup.bash; source ${D_TASK_WS}/install/setup.bash; ros2 launch uav_vision d_task_vision.launch.py input_source:=h7'
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
